          .margin({ bottom: 8 })

        TextInput({ text: this.inputTitle, placeholder: 'è¯·è¾“å…¥å¾…åŠžäº‹é¡¹æ ‡é¢˜' })
          .width('100%')
          .height(48)
          .fontSize(16)
          .backgroundColor('#FFFFFF')
          .borderRadius(12)
          .padding({ left: 16, right: 16 })
          .border({ width: 1, color: '#E5E7EB' })
          .onChange((value: string) => {
            this.inputTitle = value;
          })

        // Divider
        Divider()
          .strokeWidth(1)
          .color('#E5E7EB')
          .margin({ top: 20, bottom: 20 })

        // Content input
        Text('å†…å®¹')
          .fontSize(14)
          .fontColor('#666666')
          .width('100%')
          .margin({ bottom: 8 })

        TextArea({ text: this.inputContent, placeholder: 'è¯·è¾“å…¥å¾…åŠžäº‹é¡¹çš„å…·ä½“å†…å®¹ï¼ˆé€‰å¡«ï¼‰' })
          .width('100%')
          .height(160)
          .fontSize(15)
          .backgroundColor('#FFFFFF')
          .borderRadius(12)
          .padding({ left: 16, right: 16, top: 12, bottom: 12 })
          .border({ width: 1, color: '#E5E7EB' })
          .onChange((value: string) => {
            this.inputContent = value;
          })
      }
      .width('100%')
      .padding(16)

      Blank()

      // Bottom buttons
      Row() {
        Button('å–æ¶ˆ')
          .fontSize(16)
          .fontColor('#666666')
          .layoutWeight(1)
          .height(48)
          .backgroundColor('#F1F3F5')
          .borderRadius(12)
          .margin({ right: 8 })
          .onClick(() => {
            this.goBack();
          })

        Button('ä¿å­˜')
          .fontSize(16)
          .fontColor('#FFFFFF')
          .layoutWeight(2)
          .height(48)
          .backgroundColor(this.inputTitle.trim().length > 0 ? '#007DFF' : '#B0C4DE')
          .borderRadius(12)
