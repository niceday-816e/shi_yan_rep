import router from '@ohos.router';
import { TodoDataStore, TodoItem } from '../common/utils/TodoDataStore';

@Entry
@Component
struct TodoDetailPage {
  private dataStore: TodoDataStore = TodoDataStore.getInstance();
  private todoId: number = 0;
  @State todoItem: TodoItem | undefined = undefined;

  aboutToAppear(): void {
    let params = router.getParams() as Record<string, number>;
    if (params && params['todoId'] !== undefined) {
      this.todoId = params['todoId'];
      this.todoItem = this.dataStore.getTodoById(this.todoId);
    }
  }

  /**
   * Format timestamp to readable time string.
   */
  private formatTime(timestamp: number): string {
    let date = new Date(timestamp);
    let year = date.getFullYear();
    let month = (date.getMonth() + 1).toString().padStart(2, '0');
    let day = date.getDate().toString().padStart(2, '0');
    let hour = date.getHours().toString().padStart(2, '0');
    let minute = date.getMinutes().toString().padStart(2, '0');
    return `${year}-${month}-${day} ${hour}:${minute}`;
  }

  build(): void {
    Column() {
      // Title bar with back button
      Row() {
        Button() {
          Text('â† è¿”å›')
            .fontSize(16)
            .fontColor('#007DFF')
        }
        .backgroundColor(Color.Transparent)
        .onClick(() => {
          router.back();
        })

        Text('å¾…åŠè¯¦æƒ…')
          .fontSize(20)
          .fontWeight(FontWeight.Bold)
          .fontColor('#182431')
          .layoutWeight(1)
          .textAlign(TextAlign.Center)
      }
      .width('100%')
      .height(56)
      .padding({ left: 12, right: 12 })

      if (this.todoItem) {
        Column() {
          // Title section
          Column() {
            Text(this.todoItem.title)
              .fontSize(20)
              .fontWeight(FontWeight.Bold)
              .fontColor('#182431')
              .width('100%')

            Row() {
              Text('åˆ›å»ºæ—¶é—´ï¼š')
                .fontSize(13)
                .fontColor('#999999')
              Text(this.formatTime(this.todoItem.createTime))
                .fontSize(13)
                .fontColor('#999999')
            }
            .width('100%')
            .margin({ top: 8 })
          }
          .width('100%')
          .padding(16)
          .alignItems(HorizontalAlign.Start)

          Divider()
            .strokeWidth(1)
            .color('#E5E7EB')

          // Content section
          Column() {
            Text('å†…å®¹')
              .fontSize(14)
              .fontColor('#666666')
              .width('100%')
              .margin({ bottom: 12 })

            if (this.todoItem.content && this.todoItem.content.length > 0) {
              Text(this.todoItem.content)
                .fontSize(15)
                .fontColor('#182431')
                .lineHeight(24)
                .width('100%')
            } else {
              Text('æš‚æ— å†…å®¹')
                .fontSize(15)
                .fontColor('#CCCCCC')
                .fontStyle(FontStyle.Italic)
                .width('100%')
            }
          }
          .width('100%')
          .padding(16)
          .alignItems(HorizontalAlign.Start)
        }
        .width('100%')
        .borderRadius(16)
        .backgroundColor('#FFFFFF')
        .margin({ top: 16, left: 16, right: 16 })
      } else {
        Column() {
          Text('å¾…åŠäº‹é¡¹ä¸å­˜åœ¨')
            .fontSize(16)
            .fontColor('#999999')
            .margin({ top: 60 })
        }
        .width('100%')
        .layoutWeight(1)
      }
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#F1F3F5')
  }
}
